{
  "appId": "io.sophosotp.desktop",
  "productName": "Sophos OTP",
  "asar": true,
  "npmRebuild": false,
  "directories": {
    "output": "release"
  },
  "files": [
    "desktop/main.cjs",
    "desktop/preload.cjs",
    "desktop/vault.cjs",
    "backend/dist/**/*",
    "frontend/dist/browser/**/*",
    "package.json",
    "!**/*.map",
    "!**/test/**",
    "cli/*.cjs"
  ],
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "Sophos-OTP-${version}-Windows-${arch}.${ext}",
    "signAndEditExecutable": false
  },
  "portable": {
    "requestExecutionLevel": "user"
  },
  "extraFiles": [
    {
      "from": "desktop/Sophos-OTP-CLI.cmd",
      "to": "Sophos-OTP-CLI.cmd"
    }
  ]
}
